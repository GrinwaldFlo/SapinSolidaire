APP_NAME="Sapin Solidaire"
APP_ENV=local/production 
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sapin_solidaire
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies sent over HTTPS only: set to false for local development over plain http
SESSION_SECURE_COOKIE=true

# Reverse proxy IPs/CIDRs (comma-separated) or * : required behind a proxy so the
# client IP (access-link IP rate limit) is not the proxy IP. Leave empty without proxy.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Rate limiting for email sending (in seconds)
MAIL_RATE_LIMIT_SECONDS=5

# Access link requests per IP (allow several families from a social service office)
MAIL_LINK_PER_IP_MAX=10
MAIL_LINK_PER_IP_DECAY_MINUTES=60
# Bot swarm: more than MAX requests in DECAY minutes (all IPs) blocks link
# requests for BLOCK minutes and emails the administrators
MAIL_LINK_FLOOD_MAX=60
MAIL_LINK_FLOOD_DECAY_MINUTES=10
MAIL_LINK_FLOOD_BLOCK_MINUTES=30

# Copy every sent email into the IMAP mailbox (subfolder of the Sent folder)
# Host/username/password default to the SMTP values above when left unset.
# Encryption: ssl (port 993), starttls (port 143) or none.
# Set MAIL_IMAP_SUBFOLDER empty to store copies directly in the Sent folder.
MAIL_IMAP_COPY_ENABLED=false
#MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION=ssl
#MAIL_IMAP_USERNAME=
#MAIL_IMAP_PASSWORD=
MAIL_IMAP_SENT_FOLDER=Sent
MAIL_IMAP_SUBFOLDER=SapinSolidaire
# Steps and errors are always logged to storage/logs/imap.log;
# debug also logs the full IMAP conversation (password masked).
MAIL_IMAP_DEBUG=false

# Swiss Post Address API (optional) https://developer.post.ch/en/address-web-services-rest
SWISSPOST_API_LOGIN=
SWISSPOST_API_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# To access dignostic webserver page
DIAG_TOKEN=
